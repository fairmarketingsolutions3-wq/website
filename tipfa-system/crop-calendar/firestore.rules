rules_version = '2';

/*
 * TIPFA Crop Calendar — Firestore security rules
 *
 * The crop-calendar-only copy of the TIPFA platform. These rules cover its
 * three collections and nothing else:
 *
 *   calendarSettings/signup   the two sign-up codes, farmCode and operatorCode.
 *                             No client can read or write it; the rules read
 *                             it on the client's behalf, so a code is checked
 *                             without ever being sent to a browser. Create it
 *                             by hand in the console (see FIREBASE.md).
 *
 *   calendarOperators/{uid}   one document per Secretariat operator. Its
 *                             existence is what makes someone an operator.
 *
 *   calendarFarms/{uid}       one document per farm: its details, how it is
 *                             divided (units and blocks), and its plantings
 *                             with their coloured weeks.
 *
 * The rule throughout, as on the platform: a farm reads and writes only its
 * own calendar; operators read every farm's calendar and change none; nobody
 * creates an account without the matching code from the Secretariat.
 *
 * IMPORTANT — a Firestore database has ONE set of rules. Publishing this file
 * into a project that already runs the full platform REPLACES the platform's
 * rules and locks the platform out of its own data. Use a project of its own,
 * or paste only the marked section below into the platform's
 * firestore.rules, above its final catch-all. FIREBASE.md walks through both.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- From here to the end marker: what to paste into the platform's
    //      rules if the two share a project. The platform already defines
    //      signedIn() exactly as above, so it is left out of the paste; the
    //      names below are not used by the platform's rules. ----

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function calendarCodes() {
      return get(/databases/$(database)/documents/calendarSettings/signup).data;
    }
    function isCalendarOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/calendarOperators/$(request.auth.uid));
    }
    // Everything a farm document may hold. signupCode is allowed only so the
    // create rule can check it; it is deleted straight afterwards.
    function farmShape(d) {
      return d.keys().hasOnly(['name', 'contact', 'phone', 'email', 'location', 'registered',
                               'units', 'rows', 'startYear', 'updatedAt', 'signupCode'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.units is list && d.units.size() >= 1 && d.units.size() <= 200
        && d.rows is list && d.rows.size() <= 1000;
    }

    match /calendarSettings/signup {
      allow read, write: if false;            // the console only
    }

    match /calendarOperators/{uid} {
      allow read: if isSelf(uid) || isCalendarOperator();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'signupCode', 'since'])
        && request.resource.data.signupCode == calendarCodes().operatorCode;
      // The code goes the moment the account exists; a name may be corrected.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signupCode', 'name'])
        && !('signupCode' in request.resource.data);
      allow delete: if false;
    }

    match /calendarFarms/{uid} {
      allow read: if isSelf(uid) || isCalendarOperator();
      allow create: if isSelf(uid)
        && farmShape(request.resource.data)
        && request.resource.data.signupCode == calendarCodes().farmCode;
      // Only the farm edits its calendar, and never puts a code back.
      allow update: if isSelf(uid)
        && farmShape(request.resource.data)
        && !('signupCode' in request.resource.data);
      allow delete: if false;
    }

    // ---- End of the blocks to paste. ----

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
