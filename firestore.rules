rules_version = '2';

/*
 * TIPFA Association Platform — Firestore security rules
 *
 * Paste these into the Firebase console:
 *   Build → Firestore Database → Rules → replace everything → Publish
 *
 * The shape they enforce:
 *
 *   settings/signup      the two sign-up codes. No client can read this
 *                        document. Rules read it on the client's behalf to
 *                        check a code, so a code is never exposed to the
 *                        browser, only checked against it.
 *
 *   users/{uid}          one document per operator, keyed by their Firebase
 *                        Auth user id: which role they hold in the console,
 *                        and whether the account is still active. Roles
 *                        belong to the association's own staff — a farm
 *                        signs in as a farm and never has one. Only the
 *                        system owner may change a role or a status;
 *                        everyone else may correct their own name and phone
 *                        and nothing more.
 *
 *   operators/{uid}      one document per Secretariat operator, keyed by
 *                        their Firebase Auth user id. The presence of the
 *                        document is what makes someone an operator.
 *
 *   farms/{uid}          one document per member farm, keyed by that farm's
 *                        Firebase Auth user id: profile, crops, the crop
 *                        calendar programme, market prices and archives.
 *
 *   harvest/{uid}        that farm's harvest figures, kept separate so a
 *                        season of weekly entries never pushes the farm
 *                        document toward the 1 MiB limit.
 *
 *   submissions/{id}     requests and complaints raised by farms.
 *
 * The rule throughout: a farm reads and writes only its own records; staff
 * read everything and may correct anything their role covers; nobody may
 * create an account without the matching code from the Secretariat; and no
 * one may hand themselves a role.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Roles ----------------------------------------------------------
    // A role lives in users/{uid} and only the system owner may write it, so
    // it cannot be self-granted. Firestore caches the result of a get() on
    // the same path for the whole of one rule evaluation, so the helpers
    // below cost one read no matter how many of them a rule calls.
    function userRec() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasUserRec() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // .get(key, default) rather than a bare field, so a record written before
    // a field existed is treated as not holding it rather than erroring the
    // whole evaluation — which would read as a refusal with no cause.
    function hasRole(roles) {
      return hasUserRec()
        && userRec().get('status', '') == 'active'
        && userRec().get('role', '') in roles;
    }

    // Accounts made before roles existed are still operators: the presence of
    // an operators/{uid} document is the older proof, and it keeps working.
    function hasOperatorDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid));
    }

    // Anyone on the association's side of the platform. Reading only.
    function isStaff() {
      return hasOperatorDoc()
        || hasRole(['superAdmin','secretariat','qualityOfficer','agronomist',
                    'logistics','auditor']);
    }

    // Staff who may change members' records. An auditor is deliberately not
    // here: an auditor sees everything and touches nothing.
    function isOperator() {
      return hasOperatorDoc()
        || hasRole(['superAdmin','secretariat','qualityOfficer','agronomist',
                    'logistics']);
    }

    // The Secretariat's own settings — the catalogue and the sign-up codes.
    function isSecretariat() {
      return hasOperatorDoc() || hasRole(['superAdmin','secretariat']);
    }

    function isOwner() {
      return hasRole(['superAdmin']);
    }

    // Who claimed the association's settings. Written once, by the first
    // operator to arrive, and never again — which is what makes 'superAdmin'
    // something that cannot be handed to yourself.
    function ownerIsClaimed() {
      return exists(/databases/$(database)/documents/settings/ownership);
    }
    function ownerUid() {
      return get(/databases/$(database)/documents/settings/ownership).data.get('owner', '');
    }

    // Rules may read documents the client cannot, which is what keeps the
    // sign-up codes secret while still letting them be checked.
    function codes() {
      return get(/databases/$(database)/documents/settings/signup).data;
    }
    function hasFarmCode() {
      return request.resource.data.signupCode == codes().farmCode;
    }
    function hasOperatorCode() {
      return request.resource.data.signupCode == codes().operatorCode;
    }

    // ---- Sign-up codes -------------------------------------------------
    // Never readable by a client. The Secretariat changes them through the
    // platform.
    match /settings/signup {
      allow read: if false;
      allow write: if isSecretariat();
    }

    // ---- Ownership -------------------------------------------------------
    // Rules cannot count a collection, so being the first operator is not
    // something the platform can prove by looking. It is claimed instead: an
    // operator writes their own user id here, and because create applies only
    // to a document that does not exist, the second claim is refused. Reading
    // it tells a signed-in person only which account owns the settings.
    match /settings/ownership {
      allow read:   if signedIn();
      allow create: if signedIn()
                    && request.resource.data.get('owner', '') == request.auth.uid
                    && exists(/databases/$(database)/documents/operators/$(request.auth.uid));
      allow update, delete: if isOwner();
    }

    // ---- Crop catalogue --------------------------------------------------
    // The crops and varieties every farm chooses from, with the plant spacing
    // and per-plant yield their harvest plans are built from. The Secretariat
    // keeps it; every signed-in farm reads it. It holds no secrets — a farm is
    // meant to see all of it.
    match /settings/catalogue {
      allow read: if signedIn();
      allow write: if isSecretariat();
    }

    // ---- Roles ------------------------------------------------------------
    // One document per operator. Farms are not in here: a role is what an
    // operator holds in the console, and a farm's rights come from owning
    // its own farms/{uid} record, not from a role.
    match /users/{uid} {
      // Your own record, or anyone's if you are staff.
      allow read: if owns(uid) || isStaff();

      // A record is written by the operator it belongs to, straight after
      // sign-up — but only the role that sign-up actually earned. An
      // operators document exists only if the operator code was given, so
      // the code check that guarded that create guards this one too, and a
      // farm — which has no operators document — cannot write one at all.
      // Everything above Secretariat is the system owner's to grant, and
      // ownership itself is claimed in settings/ownership first.
      allow create: if isOwner()
                    || (owns(uid)
                        && exists(/databases/$(database)/documents/operators/$(uid))
                        && request.resource.data.get('status', '') == 'active'
                        && (
                          request.resource.data.get('role', '') == 'secretariat'
                          // Ownership is not a role you may write for
                          // yourself: it is a role you may write only once
                          // you already hold the claim.
                          || (request.resource.data.get('role', '') == 'superAdmin'
                              && ownerIsClaimed() && ownerUid() == uid)
                        ));

      // The two fields that decide what an operator may do are the system
      // owner's to set. Everyone else may correct their own name, phone and
      // regions, and nothing else — including their own role.
      allow update: if isOwner()
                    || (owns(uid)
                        && request.resource.data.get('role', '') == resource.data.get('role', '')
                        && request.resource.data.get('status', '') == resource.data.get('status', ''));

      // Suspend by setting status, rather than deleting. Removing the record
      // outright is the owner's, and never their own.
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // ---- Operators -----------------------------------------------------
    match /operators/{uid} {
      // Everyone may read their own operator document — a farm signing in asks
      // whether it has one, and must be told no rather than refused. Reading
      // anyone else's is for staff.
      allow read: if owns(uid) || isStaff();
      // A new operator registers themselves, but only with the operator code
      // and only against their own user id.
      allow create: if owns(uid) && hasOperatorCode();
      allow update: if owns(uid) || isOperator();
      allow delete: if isOperator() && request.auth.uid != uid;   // never the last one out
    }

    // ---- Member farms --------------------------------------------------
    match /farms/{uid} {
      allow read:   if owns(uid) || isStaff();
      allow create: if owns(uid) && hasFarmCode()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.email is string;
      allow update: if owns(uid) || isOperator();
      allow delete: if isOperator();
    }

    // ---- Harvest figures ------------------------------------------------
    match /harvest/{uid} {
      allow read:   if owns(uid) || isStaff();
      allow write:  if owns(uid) || isOperator();
    }

    // ---- Requests and complaints ----------------------------------------
    match /submissions/{id} {
      allow read:   if isStaff()
                    || (signedIn() && resource.data.farmUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.farmUid == request.auth.uid;
      // A farm may not reopen or reassign what the Secretariat has handled.
      allow update, delete: if isOperator();
    }

    // A farm listing its own submissions asks for exactly those, and the read
    // rule above is what permits it. Staff list the collection whole.
    match /submissions/{document=**} {
      allow read: if isStaff();
    }

    // ---- Diagnostics ----------------------------------------------------
    // Two documents that are never created. They exist only so the platform
    // can read them and learn why a sign-up was refused, without a code ever
    // reaching the browser:
    //
    //   rules-published  readable always. If reading it is refused, these
    //                    rules were never published — the console is still
    //                    running its own default rules.
    //   codes-present    readable only when settings/signup exists. If
    //                    reading it is refused, the codes document has not
    //                    been created.
    //
    // Both are safe: a read of a document that does not exist returns
    // nothing, so neither can leak a code or anyone's records.
    match /diagnostics/rules-published {
      allow read: if true;
      allow write: if false;
    }
    match /diagnostics/codes-present {
      allow read: if exists(/databases/$(database)/documents/settings/signup);
      allow write: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
